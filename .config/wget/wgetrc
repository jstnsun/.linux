# wgetrc
#
# Configuration file for the wget web retrieval program.
# See https://www.gnu.org/software/wget/ for more information.
#
# jstnsun

adjust_extension = on
backups = 1
compression = auto
continue = on
hsts_file = ~/.local/state/wget/hsts
https_only = on
ignore_case = on
max_redirect = 5
no_parent = on
restrict_file_names = unix,lowercase
robots = off
timeout = 60
timestamping = on
tries = 5
verbose = off
