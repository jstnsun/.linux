# .zshenv
#
# Environment configuration file for the Z shell (Zsh).
# See https://zsh.sourceforge.io/Intro/intro_3.html for more information.
#
# jstnsun

ZCOREDIR="${ZDOTDIR:-$HOME/.config/zsh}/core"
ZEXTRADIR="${ZDOTDIR:-$HOME/.config/zsh}/extra"
ZDEPENDDIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/dependency"
ZPLUGINDIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugin"
